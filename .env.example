# Copy to .env (gitignored) and fill in for your own local runs.
# Nothing here is read automatically by Python unless you load it yourself,
# e.g. `set -a; source .env; set +a` before running vulnforge, or use
# `python-dotenv` / direnv if you prefer.

# Default auth file for `vulnforge scan` when --auth is omitted.
VULNFORGE_AUTH_FILE=configs/my-target-auth.json

# Default scope policy file when --scope is omitted.
VULNFORGE_SCOPE_FILE=configs/my-target-scope.json

# Where the scan database lives (already supported by the CLI).
VULNFORGE_SCAN_DB_PATH=vulnforge.db
